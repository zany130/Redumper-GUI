  <name>Redumper GUI</name>
  <summary>Dump optical discs with a graphical interface</summary>

  <metadata_license>MIT</metadata_license>
  <project_license>GPL-3.0-only</project_license>

  <developer id="io.github.deterous">
    <name>Deterous</name>
